node_modules/
.next/
.env.local
.env*.local
*.tsbuildinfo
.vercel

# Local SQLite databases (large, regenerated from scripts)
knesset.db
apps/knesset-watch/knesset.db

# Downloaded documents and protocols (local only, not for VCS)
apps/knesset-watch/documents/
apps/knesset-watch/protocols/

# Script run logs
apps/knesset-watch/overnight*.log
apps/knesset-watch/*.log

# macOS artifacts
.DS_Store
apps/.DS_Store

# Playwright MCP session cache
.playwright-mcp/

# Bill source PDFs — kept on disk, never in git (see README: save originals, don't commit them)
apps/knesset-watch/bill-documents/

# Local DB snapshots (85-180MB each, regenerable).
# NOTE: knesset-deploy.db stays tracked — it is the build artifact source.
#
# הרשימה הייתה מפורשת לפי שם, ולכן כל גיבוי חדש נכנס לא-מוגן:
# knesset.before-extract.db ו-knesset.before-analysis.db יחד הם 260MB
# שהיו נכנסים לריפו ב-`git add -A` אחד. הדפוס מכסה גם גיבויים עתידיים,
# והחריג שומר על קובץ הבנייה.
apps/knesset-watch/*.db
!apps/knesset-watch/knesset-deploy.db

# Runtime artifacts from the analysis scripts (PIDs of detached processes)
apps/knesset-watch/*.pid
